 <Window x:Class="Cyber_security_GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cyber Security AI"
        Height="700"
        Width="900"
        Background="#0F172A"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <!-- Top Bar -->
        <Border Background="#111827"
                Height="75"
                VerticalAlignment="Top">

            <StackPanel Orientation="Horizontal"
                        Margin="20,10">

                <!-- Logo -->
                <Image Source="/Images/Logo.png"
                       Width="50"
                       Height="50"/>

                <!-- App Name -->
                <TextBlock Text="CYBER SECURITY AWERENESS BOT"
                           Foreground="#FF00EDFF"
                           FontSize="24"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="15,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Chat Area -->
        <Border Margin="20,90,20,100"
                Background="#1E293B"
                CornerRadius="15"
                Padding="10">

            <RichTextBox x:Name="ChatBox"
                         Background="Transparent"
                         Foreground="White"
                         BorderThickness="0"
                         FontSize="15"
                         VerticalScrollBarVisibility="Auto"
                         IsReadOnly="True" SelectionBrush="#FF0476D0"/>
        </Border>

        <!-- Bottom Input Area -->
        <Border Background="#111827"
                Height="80"
                VerticalAlignment="Bottom">

            <Grid Margin="20">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>

                <!-- Input Box -->
                <TextBox x:Name="UserInputBox"
                         Grid.Column="0"
                         Height="40"
                         FontSize="14"
                         Background="#1E293B"
                         Foreground="White"
                         BorderBrush="#FF00EDFF"
                         BorderThickness="2"
                         Padding="10"
                         VerticalContentAlignment="Center"/>

                <!-- Send Button -->
                <Button x:Name="SendButton"
                        Grid.Column="1"
                        Content="SEND"
                        Margin="10,0,0,0"
                        Background="#FF00EDFF"
                        Foreground="Black"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Click="SendButton_Click"/>

                <!-- Clear Button -->
                <Button x:Name="ClearButton"
                        Grid.Column="2"
                        Content="CLEAR"
                        Margin="10,0,0,0"
                        Background="#DC2626"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Click="ClearButton_Click"/>
            </Grid>
        </Border>

    </Grid>
</Window>



